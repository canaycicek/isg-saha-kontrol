rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to get user role from users collection
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }
    
    // Helper function to check if user is technical team
    function isTechnical() {
      return isSignedIn() && getUserRole() == 'technical';
    }
    
    // Users collection - only admins can manage
    match /users/{userId} {
      // Everyone can read their own user document
      allow read: if isSignedIn() && request.auth.uid == userId;
      
      // Only admins can create, update, or delete users
      allow create, update, delete: if isAdmin();
    }
    
    // Inspections collection (saha kontrol kayıtları)
    match /inspections/{inspectionId} {
      // Both admin and technical can read all inspections
      allow read: if isSignedIn();
      
      // Only admin can create new inspections
      allow create: if isAdmin();
      
      // Admin can update everything
      // Technical can only update the 'durum' field
      allow update: if isAdmin() || 
                      (isTechnical() && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum', 'updatedAt', 'updatedBy']));
      
      // Only admin can delete
      allow delete: if isAdmin();
    }
    
    // Notifications collection - for real-time updates to technical team
    match /notifications/{notificationId} {
      // Everyone can read their own notifications
      allow read: if isSignedIn();
      
      // Only system (admin) can create notifications
      allow create: if isAdmin();
      
      // Users can update their own notifications (e.g., mark as read)
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Admins can delete any notification
      allow delete: if isAdmin();
    }
  }
}
